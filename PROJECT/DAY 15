/**
 * index.php
 * Main entry point and router for College ERP (Compact 5-File Version)
 */
require_once __DIR__ . '/core.php';
require_once __DIR__ . '/admin.php';
require_once __DIR__ . '/portals.php';
$page = $_GET['page'] ?? 'login';
// Routing Switch
switch ($page) {
    case 'login':
        if (currentUserId()) {
            $r = currentRole();
            redirect('?page=' . ($r==='admin' ? 'admin_dash' : ($r==='teacher' ? 'teacher_dash' : 'student_dash')));
        }
        
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $email = trim($_POST['email'] ?? '');
            $pass = $_POST['password'] ?? '';
            
            $u = dbFetchOne("SELECT * FROM users WHERE email=? AND is_active=1", [$email]);
            if ($u && password_verify($pass, $u['password_hash'])) {
                $_SESSION['user_id'] = $u['id'];
                $_SESSION['user_role'] = $u['role'];
                dbExecute("UPDATE users SET last_login=NOW() WHERE id=?", [$u['id']]);
                
                if ($u['role'] === 'student') {
                    $ent = dbFetchOne("SELECT id FROM students WHERE user_id=?", [$u['id']]);
                } else if ($u['role'] === 'teacher') {
                    $ent = dbFetchOne("SELECT id FROM teachers WHERE user_id=?", [$u['id']]);
                } else {
                    $ent = ['id'=>0];
                }
                $_SESSION['entity_id'] = $ent['id'] ?? 0;
                
                redirect('?page=' . ($u['role']==='admin' ? 'admin_dash' : ($u['role']==='teacher' ? 'teacher_dash' : 'student_dash')));
            }
            setFlash('danger', 'Invalid credentials');
            redirect('?page=login');
        }
        
        renderHeader('Login');
        ?>
